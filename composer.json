{
    "name": "makallio85/rocksoftware-cakephp-ui",
    "description": "CakePHP 5 plugin with the shared screen frame of a Rock Software application: page layout, top bar, slide-out main menu, user menu, sign-in and error layouts, flash messages, styles and icons.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "layout", "theme", "bootstrap", "navigation"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Marko Kallio",
            "email": "marko@rocksoftware.fi"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.2",
        "makallio85/rocksoftware-cakephp-settings": "^1.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "suggest": {
        "makallio85/rocksoftware-cakephp-users": "Fills the user menu: the signed-in person, the other applications and sign-out"
    },
    "autoload": {
        "psr-4": {
            "RockSoftware\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RockSoftware\\Ui\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --colors -p src/ tests/ templates/",
        "cs-fix": "phpcbf --colors -p src/ tests/ templates/",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    }
}
